---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import InteriorHero from "../../../components/interior/InteriorHero.astro";
import InteriorCTA from "../../../components/interior/InteriorCTA.astro";
import { breadcrumbSchema } from "../../../data/schemas";

const lang = "en";

const jsonLd = breadcrumbSchema([
  { name: "Home", url: "/en" },
  { name: "About SNA", url: "/en/about" },
  { name: "Social responsibility" },
]);

const principles = [
  "Flexibility with responsibility",
  "Equity across roles",
  "Mandatory planning",
  "Fair compensation",
];
---

<BaseLayout
  title="Social responsibility — EFR Policy | SNA Consultoría Acústica"
  description="SNA publishes its commitment to the Family-Responsible Company (EFR) framework: an internal policy on work-life balance, flexibility and compensation tailored to acoustic consulting."
  canonical="https://snaconsultoriaacustica.com/en/about/social-responsibility"
  jsonLd={jsonLd}
  lang={lang}
>
  <InteriorHero
    compact
    breadcrumbs={[
      { label: "Home", href: "/" },
      { label: "About SNA", href: "/sobre-nosotros" },
      { label: "Social responsibility" },
    ]}
    title="Social responsibility"
    subtitle="SNA's commitment to the people who make up the company, made public and verifiable. This section gathers the policies and documents that turn that commitment into practice."
    bgImage="/images/responsabilidad-social.png"
    lang={lang}
  />

  <!-- Intro -->
  <section class="py-16 lg:py-20 bg-background">
    <div class="max-w-[760px] mx-auto px-6 lg:px-8">
      <p class="text-[15px] text-sna-text leading-relaxed">
        Social responsibility at SNA starts from within: in the actual conditions in which the team carries out its work, in how time is organised and in the recognition of the demands that technical work imposes. What follows is the first piece of that commitment, made public for anyone who wishes to consult it.
      </p>
    </div>
  </section>

  <!-- EFR block -->
  <section class="py-16 lg:py-24 bg-sna-gray-bg border-t border-sna-gray-line">
    <div class="max-w-[900px] mx-auto px-6 lg:px-8">

      <div class="grid grid-cols-1 lg:grid-cols-[180px_1fr] gap-10 lg:gap-14 items-start">

        <!-- EFR logo -->
        <div class="shrink-0">
          <img
            src="/images/efr-logo.png"
            alt="Family-Responsible Company"
            class="w-32 lg:w-40 h-auto"
            width="160"
            height="100"
          />
        </div>

        <!-- Content -->
        <div>
          <p class="text-xs font-mono uppercase tracking-widest text-sna-teal mb-3">Document 01</p>
          <h2 class="text-2xl lg:text-[32px] font-semibold leading-tight text-sna-text mb-6">
            EFR Policy and Protocol
          </h2>

          <div class="space-y-5 text-[15px] text-sna-text leading-relaxed mb-8">
            <p>
              SNA publicly assumes its voluntary commitment to the <strong>Family-Responsible Company (EFR)</strong> framework developed by Fundación Másfamilia, a Spanish standard recognised by the Ministry of Equality. Effective from 11 May 2026, the policy establishes an internal framework of flexibility, planning and compensation adapted to the realities of acoustic consulting and engineering work — a combination of office tasks, technical reporting, field measurements, on-site assistance and travel.
            </p>
            <p>
              The full document sets out specific measures by professional profile, the implementation protocol and the monitoring mechanisms.
            </p>
          </div>

          <p class="text-xs font-mono uppercase tracking-widest text-sna-teal mb-3">Underlying principles</p>
          <ul class="space-y-2 mb-10">
            {principles.map((p) => (
              <li class="flex items-start gap-3 text-[15px] text-sna-text leading-relaxed">
                <span class="text-sna-accent shrink-0 mt-[10px]" aria-hidden="true">
                  <svg width="6" height="6" viewBox="0 0 6 6" fill="currentColor"><circle cx="3" cy="3" r="3" /></svg>
                </span>
                <span>{p}</span>
              </li>
            ))}
          </ul>

          <a
            href="/downloads/sna-politica-efr.pdf"
            download
            class="group inline-flex items-center justify-center bg-primary text-primary-foreground px-7 py-3.5 text-sm font-medium rounded-none hover:bg-sna-accent hover:text-sna-dark transition-all duration-200"
          >
            <span class="transition-transform duration-200 group-hover:-translate-x-1">
              Download EFR policy (PDF, 28 p., Spanish)
            </span>
            <span class="max-w-0 overflow-hidden opacity-0 group-hover:max-w-[20px] group-hover:opacity-100 transition-all duration-200 ml-0 group-hover:ml-2">
              &darr;
            </span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <InteriorCTA
    title="Want to know more about how we work?"
    buttonLabel="Contact SNA"
    lang={lang}
  />
</BaseLayout>
